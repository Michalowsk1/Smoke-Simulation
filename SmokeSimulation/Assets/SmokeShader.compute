// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float4> Result;


struct SmokeParticle
{
    float2 particlePos;
    float2 particleVel;
    float4 particleColor;      
};

RWStructuredBuffer<SmokeParticle> particles;
uint _particleCount;
float _currAlpha;
float _alphaDecreaser;

[numthreads(64, 1, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    // TODO: insert actual code here!
    if (id.x >= _particleCount)
        return;
    
    SmokeParticle particle = particles[id.x];
    
    particle.particlePos += particle.particleVel;
    
    particle.particleColor = float4(1, 1, 1, 1);
    
    particles[id.x] = particle;
}
